<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Validar_Telefone</fullName>
    <active>true</active>
    <description
  >Garante telefone no padrão (XX)XXXXXXXXX para a Connecta Solutions.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Phone)),
    NOT(
      OR(
        REGEX(Phone, &quot;^\\([0-9]{2}\\)[0-9]{9}$&quot;),
        REGEX(Phone, &quot;^\\([0-9]{2}\\) [0-9]{4,5}-[0-9]{4}$&quot;)
      )
    )
  )</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage
  >Para manter a qualidade da Connecta, use o formato: (XX)XXXXXXXXX</errorMessage>
</ValidationRule>
